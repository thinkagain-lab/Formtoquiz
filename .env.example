# FormToQuiz environment variables
#
# The app runs fully without any keys: when GROQ_API_KEY is not set,
# /api/generate falls back to a deterministic offline quiz generator so
# the whole flow can be demonstrated end to end.

# AI generation (optional). Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model to use on Groq (optional, has a sensible default)
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube transcripts in production (optional but recommended when deployed).
# YouTube blocks transcript requests from cloud/datacenter IPs (Vercel, AWS...),
# so direct fetching only works in local dev. Set a Supadata API key to make
# the YouTube tab work on Vercel. Free tier: https://supadata.ai
SUPADATA_API_KEY=

# One-click Google Form creation (optional). OAuth 2.0 Web client in Google Cloud.
# Enable Google Forms API + Google Drive API. Add:
#   Authorized JavaScript origins: http://localhost:3000 and https://formtoquiz.vercel.app
#   Authorized redirect URIs:
#     http://localhost:3000/api/google/callback
#     https://formtoquiz.vercel.app/api/google/callback
# Scopes: forms.body, drive.file
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Cloud project id/number for X-Goog-User-Project (quota). Example: form-to-quiz-506607
GOOGLE_CLOUD_PROJECT=
